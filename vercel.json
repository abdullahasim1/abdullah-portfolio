        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'sha256-AZLgYxI1svrqMYE0V9FTA+4RDHaZGMguXvbyWgt1oms=' 'sha256-FhblPSkHoyNrqelGfseOH21ixuf/EFlfkz/q3SQ9Ycg=' https://plausible.io; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://opengraph.githubassets.com https://avatars.githubusercontent.com; font-src 'self' data:; connect-src 'self' https://api.github.com https://api.web3forms.com https://plausible.io; manifest-src 'self'; worker-src 'self'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" }
      ]
    },
    {
