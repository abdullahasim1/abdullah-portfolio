{
  "name": "abdullah-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/build-content.mjs",
    "build": "vite build && node scripts/prerender-shells.mjs",
    "prebuild": "node scripts/build-content.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "pretest": "node scripts/build-content.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "analyze": "ANALYZE=1 vite build",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.4",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.36.0",
    "tailwindcss": "^4.3.4",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "marked": "^18.1.3",
    "rollup-plugin-visualizer": "^7.1.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": "eslint --fix"
  }
